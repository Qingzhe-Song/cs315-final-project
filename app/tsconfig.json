{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmitOnError": true,
    "lib": ["DOM", "ES2020"],
    "skipLibCheck": true,
    "rootDir": "frontend",
    "outDir": "public/assets"
  },
  "include": ["frontend/**/*.ts", "frontend/**/*.tsx", "frontend/**/*.d.ts"],
  "exclude": ["node_modules"]
}
