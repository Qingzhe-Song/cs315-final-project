{
  // compiler options define how vite and typescript validate frontend code.
  "compilerOptions": {
    // target modern browsers while letting vite handle emitted output.
    "target": "ES2020",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["node"],
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "lib": ["DOM", "DOM.Iterable", "ES2020"],
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      // matches vite's @ alias for source imports.
      "@/*": ["./src/*"]
    }
  },
  // include app source and vite config in type checking.
  "include": ["src", "vite.config.ts"],
  // skip dependencies because their declarations are checked separately.
  "exclude": ["node_modules"]
}
